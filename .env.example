DATABASE_URL="postgres://postgres:postgres@localhost:5432/forekinghell"
# Public site origin used for auth callback redirects. Set this in production so
# Supabase magic-link emails point at your real domain instead of localhost.
NEXT_PUBLIC_SITE_URL="https://lm-world-tour.vercel.app"
NEXT_PUBLIC_SUPABASE_URL=""
# Supabase now calls this the publishable key; ANON is still supported as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
OPENAI_API_KEY=""
OPENAI_SCORECARD_MODEL="gpt-4.1-mini"
# Required outside local development. Use an independent random 32+ byte secret
# for one-time, scope-bound scorecard proof tokens.
SCORECARD_PROOF_SECRET=""
OPENAI_COACH_MODEL="gpt-4.1-mini"
OPENAI_FAST_MODEL="gpt-4.1-mini"
OPENAI_PREMIUM_MODEL="gpt-4.1-mini"
OPENAI_WEEKLY_RECAP_MODEL="gpt-4.1-mini"
# Optional: powers real club product images and course logos from Google Custom Search.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
# Optional: fallback course-logo lookup via Google Places official websites.
GOOGLE_PLACES_API_KEY=""
# Optional: use a broader Maps Platform key for Places, Static Maps, Street View, and Elevation.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_ENABLE_SHOT_PATTERN="true"
RAPSODO_TOKEN_SECRET=""
RAPSODO_API_BASE_URL="https://mlm.rapsodo.com"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PLUS_MONTHLY_PRICE_ID=""
STRIPE_PLUS_YEARLY_PRICE_ID=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
STRIPE_COACH_MONTHLY_PRICE_ID=""
STRIPE_COACH_YEARLY_PRICE_ID=""
# Required by the exact public Vercel cron endpoint. Vercel sends this value as a Bearer token.
CRON_SECRET=""
# Optional until the external GDAL builder is deployed. When any one is set, all
# three are required. The worker secret must be an independent 32+ character value.
COURSE_TWIN_BUILDER_URL=""
COURSE_TWIN_CALLBACK_BASE_URL=""
COURSE_TWIN_WORKER_SECRET=""
COURSE_TWIN_BUILDER_HOST="127.0.0.1"
COURSE_TWIN_BUILDER_PORT="8787"
COURSE_TWIN_CALLBACK_ORIGINS="http://localhost:3000"
OPENTOPOGRAPHY_API_KEY=""
# Private Supabase Storage bucket for immutable manifests and course assets.
COURSE_TWIN_STORAGE_BUCKET="course-twins"
# Production acceptance evidence. These are file paths/identifiers, not simulated defaults.
COURSE_TWIN_GRADE_A_COURSE_ID=""
COURSE_TWIN_PHYSICAL_ACCEPTANCE_REPORT=""
# Comma-separated stable macOS, Windows and Linux release-manifest.json paths.
COURSE_TWIN_RELEASE_MANIFESTS=""
# Ed25519 public key used to verify the stable release manifests above.
FKH_RELEASE_MANIFEST_PUBLIC_KEY=""
# Optional pre-release deployment gate in front of the normal Supabase user authentication.
FKH_BASIC_AUTH_USER="forekinghell"
FKH_BASIC_AUTH_PASSWORD=""
# Emergency-only escape hatch for controlled build diagnostics. Never set in a normal deployment.
FKH_SKIP_ENV_VALIDATION=""
